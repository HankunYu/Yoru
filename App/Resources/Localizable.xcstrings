    "Adds an overlay to the player's menu showing the display and rendering state, for troubleshooting." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイとレンダリングの状態を表示するオーバーレイをプレーヤーのメニューに追加します。トラブルシューティング用です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이 및 렌더링 상태를 보여주는 오버레이를 플레이어 메뉴에 추가합니다. 문제 해결용입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在播放器菜单中加入一个显示屏幕和渲染状态的叠加层，用于排查问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在播放器選單中加入顯示螢幕和算圖狀態的疊加層，用於排查問題。"
          }
        }
      }
    },
