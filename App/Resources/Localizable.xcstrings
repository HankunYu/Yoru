    "Nothing is written until you save.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存之前不会写入任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存前不會寫入任何內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存するまで何も書き込まれません。"
          }
        },
        "ko": {
