    },
    "Any URL mpv can open: smb, http(s), dav(s).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "mpv 能打开的任意 URL：smb、http(s)、dav(s)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "mpv 能打開的任何 URL：smb、http(s)、dav(s)。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "mpv で開ける URL：smb、http(s)、dav(s)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "mpv에서 열 수 있는 모든 URL: smb, http(s), dav(s)."
          }
        }
      }
    },
