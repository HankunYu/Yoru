    "Back 10 Seconds": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后退 10 秒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "倒退 10 秒"
          }
        },
        "ja": {
