    "Bindings written in input.conf take precedence over the gestures on this page.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "input.conf 里写的绑定优先于本页的手势设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "input.conf 中寫的綁定優先於本頁的手勢設定。"
