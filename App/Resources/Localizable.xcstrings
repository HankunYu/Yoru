    "Takes .glsl shaders, .cube color tables and .group files. They are kept in the mpv/shaders folder inside YORU in the Files app, where they can also be copied directly." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".glsl シェーダ、.cube カラーテーブル、.group ファイルを読み込めます。「ファイル」App の YORU 内 mpv/shaders フォルダに保存され、そこへ直接コピーすることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".glsl 셰이더, .cube 컬러 테이블, .group 파일을 가져옵니다. 파일 앱의 YORU 안 mpv/shaders 폴더에 보관되며, 그곳에 직접 복사해도 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可导入 .glsl 着色器、.cube 调色表和 .group 组合文件。它们保存在“文件”App 中 YORU 的 mpv/shaders 文件夹里，也可以直接拷到那里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可匯入 .glsl 著色器、.cube 調色表和 .group 組合檔案。它們儲存在「檔案」App 中 YORU 的 mpv/shaders 檔案夾裡，也可以直接拷到那裡。"
          }
        }
      }
    },
