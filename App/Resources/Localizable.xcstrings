    "Jump between keyframes while dragging; land exactly on release.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动时在关键帧之间跳转，松手后精确定位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移時在關鍵影格之間跳轉，放開後精確定位。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグ中はキーフレーム単位で移動し、指を離すと正確な位置に合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하는 동안 키프레임 단위로 이동하고, 손을 떼면 정확한 위치로 맞춥니다."
          }
        }
      }
    },
    "Key and gesture bindings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键与手势绑定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵與手勢綁定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーとジェスチャの割り当て。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 및 제스처 바인딩."
          }
        }
      }
    },
