          "stringUnit": {
            "state": "translated",
            "value": "清除續播位置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生位置の記録を消去"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이어보기 위치 지우기"
          }
        }
      }
