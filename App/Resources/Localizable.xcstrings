    "Forget where every video was left off?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要清除所有视频的续播位置吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要清除所有影片的續播位置嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのビデオの再生位置の記録を消去しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 비디오의 이어보기 위치를 지우겠습니까?"
          }
        }
      }
    },
