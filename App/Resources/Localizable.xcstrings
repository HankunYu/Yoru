    "Clear Resume Positions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除续播位置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除續播位置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生位置の記録を消去"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이어보기 위치 지우기"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        }
      }
    },
    "Configuration Files": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定檔"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "構成ファイル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성 파일"
          }
        }
      }
    },
    "Continue each video where you left off.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从上次停下的位置继续播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從上次停下的位置繼續播放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の続きから再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 본 위치부터 이어서 재생합니다."
          }
        }
      }
    },
    "Copy videos into YORU with the Files app, or import them here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过「文件」App 将视频拷贝到 YORU，或在此处导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過「檔案」App 將影片拷貝到 YORU，或在此處輸入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ファイル」App でビデオを YORU にコピーするか、ここで読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 앱으로 비디오를 YORU에 복사하거나 여기에서 가져오십시오."
          }
        }
      }
    },
    "Could Not Save": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장할 수 없음"
          }
        }
      }
    },
    "Decode with the device's video hardware. Turn off only to troubleshoot.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用设备的视频硬件解码。仅在排查问题时关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用裝置的視訊硬體解碼。僅在排解問題時關閉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのビデオハードウェアでデコードします。問題を調べるとき以外はオンのままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 비디오 하드웨어로 디코딩합니다. 문제를 해결할 때만 끄십시오."
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제"
          }
        }
      }
    },
    "Diagnostics": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断信息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "診斷資訊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断情報"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        }
      }
    },
    "Edit the files directly for anything not listed above. They are the same files mpv uses on a desktop, and live in the mpv folder inside YORU in the Files app, next to fonts and scripts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上面没有列出的设置，可以直接编辑这些文件。它们与桌面版 mpv 使用的文件相同，位于「文件」App 中 YORU 的 mpv 文件夹内，与字体和脚本放在一起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上面沒有列出的設定，可以直接編輯這些檔案。它們與桌面版 mpv 使用的檔案相同，位於「檔案」App 中 YORU 的 mpv 檔案夾內，與字體和腳本放在一起。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上にない設定は、これらのファイルを直接編集してください。デスクトップ版の mpv と同じファイルで、「ファイル」App の YORU 内にある mpv フォルダに、フォントやスクリプトと一緒に保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위에 없는 설정은 이 파일을 직접 편집하십시오. 데스크탑용 mpv와 동일한 파일이며, 파일 앱의 YORU 안에 있는 mpv 폴더에 서체 및 스크립트와 함께 저장되어 있습니다."
          }
        }
      }
    },
    "English": {
      "localizations": {
