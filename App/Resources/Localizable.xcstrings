    "Seconds, minutes:seconds or hours:minutes:seconds.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以输入秒数、分:秒 或 时:分:秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可輸入秒數、分:秒 或 時:分:秒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秒、分:秒、または 時:分:秒 で入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초, 분:초 또는 시:분:초로 입력합니다."
          }
        }
      }
    },
    "Adds an overlay to the player's menu showing the display and rendering state, for troubleshooting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在播放器菜单中加入一个显示屏幕和渲染状态的叠加层，用于排查问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在播放器選單中加入顯示螢幕和算圖狀態的疊加層，用於排查問題。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイとレンダリングの状態を表示するオーバーレイをプレーヤーのメニューに追加します。トラブルシューティング用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 및 렌더링 상태를 보여주는 오버레이를 플레이어 메뉴에 추가합니다. 문제 해결용입니다."
          }
        }
      }
    },
    "Enter the address of a video or stream. Supported: http, https (including HLS and DASH streams), ftp, rtsp, rtmp and smb.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入视频或直播流的地址。支持 http、https（包括 HLS 和 DASH 流）、ftp、rtsp、rtmp 和 smb。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入影片或串流的網址。支援 http、https（包括 HLS 和 DASH 串流）、ftp、rtsp、rtmp 和 smb。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオまたはストリームのアドレスを入力してください。対応：http、https（HLSとDASHストリームを含む）、ftp、rtsp、rtmp、smb。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오 또는 스트림의 주소를 입력하십시오. 지원: http, https(HLS 및 DASH 스트림 포함), ftp, rtsp, rtmp, smb."
          }
        }
      }
    }
  }
}