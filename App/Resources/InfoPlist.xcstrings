{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YORU plays media from servers on your local network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YORU 需要访问本地网络，以播放局域网服务器上的媒体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "YORU 需要取用區域網路，以播放區域網路伺服器上的媒體。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YORU はローカルネットワーク上のサーバにあるメディアを再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "YORU는 로컬 네트워크에 있는 서버의 미디어를 재생합니다."
          }
        }
      }
    }
  }
}